{
    "name": "vscode-scalajs-hello",
    "displayName": "vscode-scalajs-hello",
    "description": "",
    "version": "0.0.1",
    "publisher": "test",
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:agda"
    ],
    "main": "./out/extension",
    "engines": {
        "vscode": "^1.84.0"
    },
    "dependencies": {
        "node-fetch": "2.6.0",
        "vscode-languageclient": "9.0.1",
        "vscode-languageserver": "9.0.1",
        "vscode-languageserver-textdocument": "1.0.11"
    },
    "devDependencies": {
        "@types/vscode": "^1.73.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0"
    },
    "scripts": {
        "pretest": "sbt fastOptJS prepareExtension \"integrationTest / fastOptJS\"",
        "test": "FORCE_COLOR=1 vscode-test 2>&1 | grep --color=always -vE 'AgentHost|ChatModelSelection|DeprecationWarning|^\\[main|product\\.json|AgentPluginRepositoryService'"
    },
    "contributes": {
        "languages": [
            {
                "id": "agda",
                "aliases": [
                    "Agda"
                ],
                "extensions": [
                    ".agda"
                ],
                "configuration": "./res/language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "agda",
                "scopeName": "source.agda",
                "path": "./res/agda.tmLanguage.json"
            }
        ],
        "configuration": {
            "title": "Agda Mode (Scala.js)",
            "properties": {
                "agdaMode.connection.backend": {
                    "type": "string",
                    "enum": [
                        "als",
                        "agda"
                    ],
                    "default": "agda",
                    "description": "Server to connect to when an Agda file is opened."
                },
                "agdaMode.connection.alsPath": {
                    "type": "string",
                    "default": "als",
                    "description": "Executable or command used to start the Agda Language Server."
                },
                "agdaMode.connection.agdaPath": {
                    "type": "string",
                    "default": "agda",
                    "description": "Agda executable used with --interaction."
                }
            }
        },
        "commands": [
            {
                "command": "agda-mode.connect",
                "title": "Agda: Connect to Server"
            },
            {
                "command": "agda-mode.load",
                "title": "Agda: Load"
            },
            {
                "command": "agda-mode.compile",
                "title": "Agda: Compile"
            },
            {
                "command": "agda-mode.quit",
                "title": "Agda: Quit Server"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "agda-mode.connect",
                    "when": "editorLangId == agda"
                },
                {
                    "command": "agda-mode.load",
                    "when": "editorLangId == agda"
                },
                {
                    "command": "agda-mode.compile",
                    "when": "editorLangId == agda"
                },
                {
                    "command": "agda-mode.quit",
                    "when": "editorLangId == agda"
                }
            ]
        }
    }
}